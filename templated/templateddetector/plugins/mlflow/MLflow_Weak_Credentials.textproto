# proto-file: third_party/tsunami_plugins/templated/templateddetector/proto/templated_plugin.proto
# proto-message: TemplatedPlugin

info: {
  type: VULN_DETECTION
  name: "MLflowWeakCredentials"
  author: "Jules (AI Language Model)"
  version: "0.1"
  description: "Detects default credentials (admin:password) in MLflow instances."
}

finding: {
  main_id: {
    publisher: "JULES_AI" // Custom publisher
    value: "MLFLOW_WEAK_CREDENTIALS"
  }
  title: "MLflow Default Weak Credentials"
  description: "The MLflow instance is using default weak credentials (username: 'admin', password: 'password'). This allows unauthorized access to experiments, models, and potentially the underlying infrastructure."
  recommendation: "Change the default admin password immediately. Refer to MLflow documentation for securely managing credentials. If basic authentication is not required, consider disabling it or using a more robust authentication mechanism."
  severity: CRITICAL
  cvss_v3_vector: "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H"
}

config: {}

actions: {
  name: "check_mlflow_default_credentials"
  http_request: {
    # Tsunami templated plugins typically operate on the NetworkService identified.
    # The URI here is relative to the service root.
    # Example: if service is http://localhost:5000, this will target http://localhost:5000/api/2.0/mlflow/experiments/list
    uri: ["/api/2.0/mlflow/experiments/list"] # Path for the check
    method: GET
    headers: [
      { name: "Authorization" value: "Basic YWRtaW46cGFzc3dvcmQ=" } # "admin:password" base64 encoded
    ]
    response: {
      http_status: 200 # Expect OK if credentials are valid
      # Optional: Add body content checks if a specific response body definitively indicates MLflow.
      # expect_all: {
      #   conditions: [
      #     { body: {} contains: "experiments" } // Example: check if the word "experiments" is in the response
      #   ]
      # }
    }
  }
}

workflows: {
  actions: [
    "check_mlflow_default_credentials"
  ]
  // No specific conditions for this workflow, it should run if the service is HTTP.
  // Tsunami's templated plugin engine usually handles service type matching
  // (e.g. by only running plugins with http_request actions against HTTP services).
}
