# proto-file: third_party/tsunami_plugins/templated/templateddetector/proto/templated_plugin_tests.proto
# proto-message: TemplatedPluginTests

tests: {
  plugin_name: "MLflowWeakCredentials"
  test_cases: [
    {
      name: "vulnerable_service_default_credentials"
      target: {
        service_info: {
          service_name: "http"
          # For a real test, Tsunami's test environment would mock the HTTP service.
          # The mock would be configured to respond with HTTP 200 OK
          # to a GET request on /api/2.0/mlflow/experiments/list
          # when the header "Authorization: Basic YWRtaW46cGFzc3dvcmQ=" is present.
        }
        # Additional mock setup would go here if the templated test format supports detailed mock definitions.
        # Based on documentation, it seems the actual mocking happens in the test execution environment
        # rather than being fully defined in this file.
      }
      expected_findings: {
        vulnerability: {
          main_id: {
            publisher: "JULES_AI"
            value: "MLFLOW_WEAK_CREDENTIALS"
          }
          severity: CRITICAL
          title: "MLflow Default Weak Credentials"
          description: "The MLflow instance is using default weak credentials (username: 'admin', password: 'password'). This allows unauthorized access to experiments, models, and potentially the underlying infrastructure."
          recommendation: "Change the default admin password immediately. Refer to MLflow documentation for securely managing credentials. If basic authentication is not required, consider disabling it or using a more robust authentication mechanism."
          cvss_v3_vector: "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H"
        }
      }
    },
    {
      name: "non_vulnerable_service_auth_failed"
      target: {
         service_info: {
           service_name: "http"
         }
         # Mock HTTP service would be configured to respond with 401 or 403
         # to the same request with the default credentials.
      }
      expected_findings: {} // No findings expected
    },
    {
      name: "non_http_service"
      target: {
        service_info: {
          service_name: "ssh" // Not an HTTP service
        }
      }
      expected_findings: {} // No findings expected as the http_request action shouldn't run
    }
  ]
}
